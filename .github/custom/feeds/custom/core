#
# 脚本核心文件
#

SOURCE_CACHE_ROOT="${OPENWRT_PACKAGES_SOURCE_CACHE:-${RUNNER_TEMP:-${TMPDIR:-/tmp}}/openwrt-packages-source-cache}"
SOURCE_CACHE_DIR=""

ensure_source_cache() {
  local source_repo_url="$1"
  local source_branch="${2:-}"
  local cache_key cache_dir staging_root
  local clone_args

  mkdir -p "$SOURCE_CACHE_ROOT"
  cache_key=$(printf '%s\0%s' "$source_repo_url" "$source_branch" | sha256sum | awk '{print $1}')
  cache_dir="$SOURCE_CACHE_ROOT/$cache_key"

  if [[ -e "$cache_dir" && ! -d "$cache_dir/.git" ]]; then
    rm -rf -- "$cache_dir"
  fi

  if [[ ! -d "$cache_dir/.git" ]]; then
    staging_root=$(mktemp -d "$SOURCE_CACHE_ROOT/.clone.XXXXXX")
    clone_args=(clone --depth 1 --single-branch --quiet)
    if [[ -n "$source_branch" ]]; then
      clone_args+=(--branch "$source_branch")
    fi
    clone_args+=("$source_repo_url" "$staging_root/repository")

    if ! git "${clone_args[@]}"; then
      rm -rf -- "$staging_root"
      echo "Git clone $source_repo_url 出错，请查看日志信息。" >&2
      return 1
    fi
    mv -- "$staging_root/repository" "$cache_dir"
    rm -rf -- "$staging_root"
  fi

  SOURCE_CACHE_DIR="$cache_dir"
}

# 执行 git clone 命令，并将输出重定向到指定文件
format_git_clone_output() {
  local repo_url=""
  local branch=""
  local clone_dir=""
  local destination_dir=""
  local repo_name=""

  # 解析命名参数
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -r | --repo )
        repo_url="$2"
        shift 2
        ;;
      -b | --branch )
        branch="$2"
        shift 2
        ;;
      -d | --clone-dir )
        clone_dir="$2"
        shift 2
        ;;
      * )
        echo "未知选项: $1"
        exit 1
        ;;
    esac
  done

  if [[ -z $repo_url ]]; then
    echo "必须提供 -r 或 --repo 参数"
    exit 1
  fi

  ensure_source_cache "$repo_url" "$branch" || exit 1
  destination_dir="$clone_dir"
  if [[ -z "$destination_dir" ]]; then
    repo_name="${repo_url%/}"
    repo_name="${repo_name##*/}"
    destination_dir="${repo_name%.git}"
  fi

  if [[ -e "$destination_dir" ]]; then
    echo "目标目录已存在，无法克隆: $destination_dir" >&2
    exit 1
  fi
  mkdir -p -- "$destination_dir"
  rsync -a \
    --exclude='.git' \
    --exclude='.gitattributes' \
    --exclude='.svn' \
    --exclude='.github' \
    --exclude='.gitignore' \
    "$SOURCE_CACHE_DIR"/ "$destination_dir"/
  echo "克隆成功：$repo_url"
}

# 使用git检出指定的代码到目标运行目录或当前目录
checkout_partial_code() {
  local repo_url=""
  local branch=""
  local preserve_links=false
  local warn_on_missing=false


  # 解析命令行参数
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --preserve-links)
        preserve_links=true
        shift
        ;;
      --warn-on-missing)
        warn_on_missing=true
        shift
        ;;
      -r | --repo)
        repo_url=$2
        shift 2
        ;;
      -b | --branch)
        branch=$2
        shift 2
        ;;
      *)
        break
        ;;
    esac
  done

  # 检查必需参数
  if [ -z "$repo_url" ]; then
    echo "错误：缺少必需的参数：-r | --repo <repository_url>"
    exit 1
  fi

  ensure_source_cache "$repo_url" "$branch" || exit 1

  local rsync_link_option="--copy-links"
  local rsync_status=0
  if [[ "$preserve_links" == true ]]; then
    rsync_link_option="--links"
  fi

  # 提取指定子目录到目标运行目录或当前目录
  for partial_path in "${@}"; do
    if ! compgen -G "$SOURCE_CACHE_DIR/$partial_path" > /dev/null; then
      if [[ "$warn_on_missing" == true ]]; then
        echo "::warning::$partial_path 文件夹不存在于仓库中，跳过 (warn-on-missing): $repo_url" >&2
        continue
      fi
      echo "错误：$partial_path 文件夹不存在于仓库中" >&2
      exit 1
    fi

    if rsync -av "$rsync_link_option" "$SOURCE_CACHE_DIR"/$partial_path .; then
      :
    else
      rsync_status=$?
      echo "错误：从 $repo_url 同步 '$partial_path' 失败（rsync 退出码 $rsync_status）" >&2
      exit "$rsync_status"
    fi
  done

  echo "检出成功：$repo_url"
}

function mvdir() {
    if [ -d "$1" ]; then
        find "$1" -mindepth 1 -maxdepth 1 -type d -exec mv -t ./ {} +
        rm -rf "$1"
    else
        echo "目录 $1 不存在"
    fi
}

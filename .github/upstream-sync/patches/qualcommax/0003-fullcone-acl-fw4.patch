--- /dev/null
+++ b/package/network/config/firewall4/patches/003-sonic-fullcone-acl.patch
@@ -0,0 +1,160 @@
+From: AutoWorkflows contributors
+Subject: [PATCH] firewall4: add per-device ACL for SONiC fullcone
+
+Restrict fullcone mapping creation to explicitly listed devices instead of
+every host of a zone. The device list is applied as extra source address
+restrictions on the srcnat rules; the inbound lookup rules are left
+unrestricted since they only resolve already existing fullcone mappings.
+
+The ACL is enabled with the new defaults.fullcone_acl switch and device
+addresses are taken from config fullcone_device sections. List entries
+are emitted verbatim, so a negated or masked entry keeps its meaning, and
+an empty device list disables fullcone mapping creation entirely.
+
+Devices without a distinct address are never matched implicitly: when no
+device matches, the zone falls back to ordinary masquerading.
+
+---
+diff --git a/root/usr/share/firewall4/templates/ruleset.uc b/root/usr/share/firewall4/templates/ruleset.uc
+index 2a2782d..a927506 100644
+--- a/root/usr/share/firewall4/templates/ruleset.uc
++++ b/root/usr/share/firewall4/templates/ruleset.uc
+@@ -351,9 +351,14 @@ table inet fw4 {
+ {%    for (let saddrs in zone.masq4_src_subnets): %}
+ {%     for (let daddrs in zone.masq4_dest_subnets): %}
+ {%      if (zone.fullcone): %}
+-{%       for (let proto in zone.fullcone_proto): %}
+-		{%+ include("zone-fullcone.uc", { fw4, zone, family: 4, direction: "srcnat", proto, saddrs, daddrs }) %}
+-{%       endfor %}
++{%       let acl = fw4.fullcone_acl_addrs(4); %}
++{%       if (acl == null || length(acl)): %}
++{%        for (let aclgrp in (acl || [ null ])): %}
++{%         for (let proto in zone.fullcone_proto): %}
++		{%+ include("zone-fullcone.uc", { fw4, zone, family: 4, direction: "srcnat", proto, saddrs, daddrs, aclgrp }) %}
++{%         endfor %}
++{%        endfor %}
++{%       endif %}
+ {%      endif %}
+ 		{%+ include("zone-masq.uc", { fw4, zone, family: 4, saddrs, daddrs }) %}
+ {%     endfor %}
+@@ -363,9 +368,14 @@ table inet fw4 {
+ {%    for (let saddrs in zone.masq6_src_subnets): %}
+ {%     for (let daddrs in zone.masq6_dest_subnets): %}
+ {%      if (zone.fullcone6): %}
+-{%       for (let proto in zone.fullcone_proto): %}
+-		{%+ include("zone-fullcone.uc", { fw4, zone, family: 6, direction: "srcnat", proto, saddrs, daddrs }) %}
+-{%       endfor %}
++{%       let acl = fw4.fullcone_acl_addrs(6); %}
++{%       if (acl == null || length(acl)): %}
++{%        for (let aclgrp in (acl || [ null ])): %}
++{%         for (let proto in zone.fullcone_proto): %}
++		{%+ include("zone-fullcone.uc", { fw4, zone, family: 6, direction: "srcnat", proto, saddrs, daddrs, aclgrp }) %}
++{%         endfor %}
++{%        endfor %}
++{%       endif %}
+ {%      endif %}
+ 		{%+ include("zone-masq.uc", { fw4, zone, family: 6, saddrs, daddrs }) %}
+ {%     endfor %}

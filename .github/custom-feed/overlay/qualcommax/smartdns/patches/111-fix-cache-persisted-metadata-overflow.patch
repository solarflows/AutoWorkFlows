From e80eb387ac1bccbe86b7ea1bbe8a3c66ce8af442 Mon Sep 17 00:00:00 2001
From: Polaris <15033876+polaris-arch@users.noreply.github.com>
Date: Sat, 7 Nov 2026 21:21:54 +0800
Subject: [PATCH 111/111] fix(cache): validate persisted metadata before
 lifetime arithmetic

Reject negative persisted lifetimes, timestamps and invalid hit counters before callback use. Saturate elapsed age before narrowing, clamp future insertion times and widen TTL/prefetch arithmetic to avoid startup overflow on damaged cache files. Keep the persisted format unchanged and exercise eight deterministic metadata boundary cases through real server restarts.
---
 src/dns_cache.c          | 20 ++++++++++++----
 test/cases/test-cache.cc | 50 ++++++++++++++++++++++++++++++++++++++++
 2 files changed, 66 insertions(+), 4 deletions(-)

diff --git a/src/dns_cache.c b/src/dns_cache.c
index 493d8288..74738d74 100644
--- a/src/dns_cache.c
+++ b/src/dns_cache.c
@@ -698,8 +698,12 @@ static int _dns_cache_read_to_cache(struct dns_cache_record *cache_record, struc
 		info->replace_time = now;
 	}
 
-	int passed_time = now - info->replace_time;
-	int timeout = info->timeout - passed_time;
+	/* Persisted timestamps are untrusted. Saturate age before narrowing and
+     * keep lifetime arithmetic wide, including prefetch's TTL sum. */
+    double elapsed = difftime(now, info->replace_time);
+    int passed_time = elapsed > INT32_MAX ? INT32_MAX : (int)elapsed;
+    int64_t timeout = (int64_t)info->timeout - passed_time;
+    if (now < info->insert_time) info->insert_time = now;
 
 	struct dns_conf_group *rule_group = dns_server_get_rule_group(info->dns_group_name);
 
@@ -717,8 +721,8 @@ static int _dns_cache_read_to_cache(struct dns_cache_record *cache_record, struc
 		}
 	}
 
-	if ((timeout > expired_time + info->ttl) && expired_time > 0) {
-		timeout = expired_time + info->ttl;
+	if ((timeout > (int64_t)expired_time + info->ttl) && expired_time > 0) {
+		timeout = (int64_t)expired_time + info->ttl;
 	}
 
 	if (timeout < DNS_CACHE_READ_TIMEOUT * 2) {
@@ -761,6 +765,14 @@ static int _dns_cache_read_record(int fd, off_t filesize, uint32_t cache_number,
 			goto errout;
 		}
 
+        const struct dns_cache_info *info = &cache_record.info;
+        if (info->ttl < 0 || info->timeout < 0 || info->insert_time < 0 || info->replace_time < 0 ||
+            info->hitnum < 0 || info->hitnum > DNS_CACHE_MAX_HITNUM ||
+            info->hitnum_update_add < 0 || info->hitnum_update_add > DNS_CACHE_HITNUM_STEP_MAX) {
+            tlog(TLOG_ERROR, "invalid persisted cache metadata, skip load cache.");
+            goto errout;
+        }
+
 		ret = read(fd, &data_head, sizeof(data_head));
 		if (ret != sizeof(data_head)) {
 			tlog(TLOG_ERROR, "read data head failed, %s", strerror(errno));
diff --git a/test/cases/test-cache.cc b/test/cases/test-cache.cc
index a60b48be..8734336e 100644
--- a/test/cases/test-cache.cc
+++ b/test/cases/test-cache.cc
@@ -16,6 +16,12 @@
  * along with this program.  If not, see <http://www.gnu.org/licenses/>.
  */
 
+#include <climits>
+#include <limits>
+#include <cstddef>
+#include <cstring>
+#include <iterator>
+#include <vector>
 #include "client.h"
 #include "smartdns/dns.h"
 #include "include/utils.h"
@@ -616,3 +622,47 @@ cache-size 100
 	EXPECT_EQ(client.GetAnswer()[0].GetName(), "cdn.other.example");
 	EXPECT_EQ(client.GetAnswer()[0].GetData(), "5.6.7.8");
 }
+
+TEST_F(Cache, PersistedLifetimeAndCountersAreValidatedBeforeUse)
+{
+    smartdns::MockServer upstream;
+    auto file="/tmp/smartdns_cache.metadata."+smartdns::GenerateRandomString(10);
+    Defer { unlink(file.c_str()); };
+    ASSERT_TRUE(upstream.Start("udp://127.0.0.1:62053",[](smartdns::ServerRequestContext *r) {
+        smartdns::MockServer::AddIP(r,r->domain.c_str(),"1.2.3.4");
+        return smartdns::SERVER_REQUEST_OK;
+    }));
+    std::string conf="bind 127.0.0.1:60053\nserver 127.0.0.1:62053\ncache-size 16\n"
+        "speed-check-mode none\ndualstack-ip-selection no\ncache-persist yes\n"
+        "prefetch-domain yes\nserve-expired yes\nserve-expired-prefetch-time 60\ncache-file "+file+"\n";
+    { smartdns::Server server; ASSERT_TRUE(server.Start(conf)); smartdns::Client client;
+      ASSERT_TRUE(client.Query("metadata.test",60053)); server.Stop(); }
+    std::ifstream in(file,std::ios::binary);
+    std::vector<char> saved((std::istreambuf_iterator<char>(in)),{}); in.close();
+    ASSERT_GE(saved.size(),sizeof(dns_cache_file)+sizeof(dns_cache_record));
+    dns_cache_record original; memcpy(&original,saved.data()+sizeof(dns_cache_file),sizeof(original));
+    ASSERT_EQ(original.magic,MAGIC_RECORD);
+    for (int variant=0;variant<8;variant++) {
+        SCOPED_TRACE(variant);
+        auto record=original;
+        switch (variant) {
+        case 0: record.info.ttl=INT_MAX; record.info.timeout=INT_MAX; break;
+        case 1: record.info.replace_time=-INT_MAX; record.info.timeout=INT_MAX; break;
+        case 2: record.info.replace_time=record.info.insert_time=(std::numeric_limits<time_t>::max)(); break;
+        case 3: record.info.insert_time=-1; break;
+        case 4: record.info.timeout=INT_MIN; break;
+        case 5: record.info.ttl=INT_MIN; break;
+        case 6: record.info.hitnum=INT_MAX; break;
+        case 7: record.info.hitnum_update_add=INT_MAX; break;
+        }
+        auto changed=saved; memcpy(changed.data()+sizeof(dns_cache_file),&record,sizeof(record));
+        { std::ofstream out(file,std::ios::binary|std::ios::trunc); out.write(changed.data(),changed.size()); }
+        smartdns::Server server; ASSERT_TRUE(server.Start(conf)); smartdns::Client client;
+        for (int repeat=0;repeat<2;repeat++) {
+            ASSERT_TRUE(client.Query("metadata.test",60053));
+            EXPECT_EQ(client.GetStatus(),"NOERROR"); ASSERT_EQ(client.GetAnswerNum(),1);
+            EXPECT_EQ(client.GetAnswer()[0].GetData(),"1.2.3.4");
+        }
+        server.Stop();
+    }
+}

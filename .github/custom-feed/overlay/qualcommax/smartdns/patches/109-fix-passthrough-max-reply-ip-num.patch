From: Dv2Corn <320380254+Dv2Corn@users.noreply.github.com>
Date: Wed, 11 Nov 2026 03:05:24 +0000
Subject: [PATCH] fix(server): apply max-reply-ip-num to passthrough replies
Origin: https://github.com/pymumu/smartdns/pull/2503
Upstream-Status: Submitted upstream (PR #2503 / Commit 49a6ebd9)

max-reply-ip-num was only enforced when smartdns synthesized answers.
Passthrough replies in fastest-response mode returned every A/AAAA record,
flooding downstream caches and nftset with uncontrolled IP lists.
Trim extra records on passthrough while preserving signed DNSSEC RRsets.
---
diff --git a/src/dns_server/context.c b/src/dns_server/context.c
index 1f086f26..73843191 100644
--- a/src/dns_server/context.c
+++ b/src/dns_server/context.c
@@ -1103,6 +1103,68 @@ int _dns_cache_reply_packet(struct dns_server_post_context *context)
 	return 0;
 }
 
+/* The upstream packet is replied as is here, so apply max-reply-ip-num like _dns_rrs_add_all_best_ip() does */
+static int _dns_server_passthrough_limit_ip(struct dns_server_post_context *context)
+{
+	struct dns_request *request = context->request;
+	struct dns_packet *packet = (struct dns_packet *)context->packet_buff;
+	struct dns_rrs *rrs = NULL;
+	struct dns_rrs *prev = NULL;
+	int max_ip_num = request->conf->dns_max_reply_ip_num;
+	int rr_count = 0;
+	int ip_num = 0;
+	int encode_len = 0;
+	int i = 0;
+
+	/* dropping records from a signed RRset would break DNSSEC validation */
+	if ((context->qtype != DNS_T_A && context->qtype != DNS_T_AAAA) || request->edns0_do) {
+		return 0;
+	}
+
+	rrs = dns_get_rrs_start(context->packet, DNS_RRS_AN, &rr_count);
+	for (i = 0; i < rr_count && rrs; i++, rrs = dns_get_rrs_next(context->packet, rrs)) {
+		if (rrs->type == context->qtype) {
+			ip_num++;
+		}
+	}
+
+	if (ip_num <= max_ip_num) {
+		return 0;
+	}
+
+	/* trim a copy, the caller may still process the full upstream answer */
+	if (dns_decode(packet, sizeof(context->packet_buff), context->inpacket, context->inpacket_len) != 0) {
+		return -1;
+	}
+
+	ip_num = 0;
+	rrs = dns_get_rrs_start(packet, DNS_RRS_AN, &rr_count);
+	for (i = 0; i < rr_count && rrs; i++, rrs = dns_get_rrs_next(packet, rrs)) {
+		if (rrs->type == context->qtype && ++ip_num > max_ip_num) {
+			if (prev) {
+				prev->next = rrs->next;
+			} else {
+				packet->answers = rrs->next;
+			}
+			packet->head.ancount--;
+			continue;
+		}
+		prev = rrs;
+	}
+
+	encode_len = dns_encode(context->inpacket_buff, sizeof(context->inpacket_buff), packet);
+	if (encode_len <= 0) {
+		return -1;
+	}
+
+	context->packet = packet;
+	context->inpacket = context->inpacket_buff;
+	context->inpacket_len = encode_len;
+	context->inpacket_maxlen = sizeof(context->inpacket_buff);
+
+	return 0;
+}
+
 int _dns_server_reply_passthrough(struct dns_server_post_context *context)
 {
 	struct dns_request *request = context->request;
@@ -1111,6 +1173,10 @@ int _dns_server_reply_passthrough(struct dns_server_post_context *context)
 		return 0;
 	}
 
+	if (_dns_server_passthrough_limit_ip(context) != 0) {
+		tlog(TLOG_DEBUG, "limit reply ip number for %s failed.", request->domain);
+	}
+
 	_dns_server_get_answer(context);
 
 	_dns_cache_reply_packet(context);
diff --git a/test/cases/test-fastest-response.cc b/test/cases/test-fastest-response.cc
index e2ff251e..6d7a9cfc 100644
--- a/test/cases/test-fastest-response.cc
+++ b/test/cases/test-fastest-response.cc
@@ -177,3 +177,47 @@ speed-check-mode ping
 	}
 	EXPECT_GT(result.ip_num, 0);
 }
+
+/* The immediate reply forwards the upstream packet: it must still honour max-reply-ip-num, with and without cache. */
+static void FastestResponseMaxReplyIPNum(const std::string &cache_size)
+{
+	smartdns::MockServer server_upstream;
+	smartdns::Server server;
+
+	server_upstream.Start("udp://0.0.0.0:61053", [](struct smartdns::ServerRequestContext *request) {
+		if (request->qtype != DNS_T_A) {
+			return smartdns::SERVER_REQUEST_SOA;
+		}
+		for (int i = 1; i <= 32; i++) {
+			smartdns::MockServer::AddIP(request, request->domain.c_str(), "10.0.0." + std::to_string(i));
+		}
+		return smartdns::SERVER_REQUEST_OK;
+	});
+
+	std::string conf = R"""(bind [::]:60053
+server 127.0.0.1:61053
+response-mode fastest-response
+max-reply-ip-num 8
+)""";
+	server.Start(conf + "cache-size " + cache_size + "\n");
+
+	smartdns::Client client;
+	for (int i = 0; i < 2; i++) {
+		ASSERT_TRUE(client.Query("a.com", 60053));
+		std::cout << client.GetResult() << std::endl;
+		EXPECT_EQ(client.GetStatus(), "NOERROR");
+		ASSERT_GT(client.GetAnswerNum(), 0);
+		EXPECT_LE(client.GetAnswerNum(), 8);
+		usleep(600 * 1000);
+	}
+}
+
+TEST_F(FastestResponse, max_reply_ip_num_no_cache)
+{
+	FastestResponseMaxReplyIPNum("0");
+}
+
+TEST_F(FastestResponse, max_reply_ip_num_cache)
+{
+	FastestResponseMaxReplyIPNum("1024");
+}

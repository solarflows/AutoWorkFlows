_dns_server_process 事件分发层对所有 conn 都少了一次 touch，进而导致每个连接关闭后产生32KB缓冲区的残留，表现为内存使用一直缓慢但不明显的增加。
---
 src/dns_server/dns_server.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/dns_server/dns_server.c b/src/dns_server/dns_server.c
index 5378bdee..b5f5ea70 100644
--- a/src/dns_server/dns_server.c
+++ b/src/dns_server/dns_server.c
@@ -572,7 +572,9 @@ errout:
 static int _dns_server_process(struct dns_server_conn_head *conn, struct epoll_event *event, unsigned long now)
 {
 	int ret = 0;
-	_dns_server_client_touch(conn);
+	if (event->events & EPOLLIN) {
+		_dns_server_client_touch(conn);
+	}
 	_dns_server_conn_get(conn);
 	if (conn->type == DNS_CONN_TYPE_UDP_SERVER) {
 		struct dns_server_conn_udp *udpconn = (struct dns_server_conn_udp *)conn;
-- 

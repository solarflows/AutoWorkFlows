diff --git a/src/dns_client/client_http2.c b/src/dns_client/client_http2.c
index 3290cbb..f6f121c 100644
--- a/src/dns_client/client_http2.c
+++ b/src/dns_client/client_http2.c
@@ -156,7 +156,22 @@ static int _dns_client_send_http2_stream(struct dns_server_info *server_info, st
 	/* Create HTTP/2 stream */
 	http2_stream = http2_stream_new(http2_ctx);
 	if (http2_stream == NULL) {
-		int ret = _dns_client_http2_send_result_from_errno(server_info, "create http2 stream", errno);
+		int ret;
+		/*
+		 * ENOSPC here means the peer's MAX_CONCURRENT_STREAMS quota is
+		 * exhausted. Healthy connections free slots within milliseconds,
+		 * so a saturated state implies leaked streams on a wedged
+		 * connection. Treat it as a connection error so the context gets
+		 * torn down and rebuilt, instead of retrying against a zombie
+		 * connection forever (DNS hang while process looks alive).
+		 */
+		if (errno == ENOSPC) {
+			tlog(TLOG_WARN, "http2 peer stream limit reached, reset connection, server=%s:%d",
+				 server_info->ip, server_info->port);
+			http2_ctx_put(http2_ctx);
+			return DNS_CLIENT_HTTP2_STREAM_SEND_CONN_ERROR;
+		}
+		ret = _dns_client_http2_send_result_from_errno(server_info, "create http2 stream", errno);
 		http2_ctx_put(http2_ctx);
 		return ret;
 	}

# ────────────────────────────────────────────────────────────
# qualcommax / ipq807x — 基础构建配置
# 此文件包含目标平台、构建选项、签名等全局开关。
# 软件包选择请编辑同目录 02-pkgs.seed。
# ────────────────────────────────────────────────────────────

# ═══════ 目标平台 ═══════
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_netgear_rbr750=y

# ═══════ 构建选项 ═══════
CONFIG_DEVEL=y                     # 开发者模式（保留源码树）
CONFIG_CCACHE=y                    # 编译缓存加速
CONFIG_BUILD_LOG=y                 # 输出编译日志
CONFIG_SDK=y                       # 生成 SDK tarball，供 packages-only 路径复用（APK 格式）
CONFIG_IB=y                        # 生成 IB tarball，供 SDK+IB 快速重打包路径复用
CONFIG_IB_STANDALONE=y             # IB 独立构建（不依赖已编译固件）